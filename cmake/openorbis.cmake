set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(OO_PS4_TOOLCHAIN "$ENV{OO_PS4_TOOLCHAIN}" CACHE PATH "OpenOrbis SDK")
if(NOT OO_PS4_TOOLCHAIN)
  set(OO_PS4_TOOLCHAIN /opt/openorbis/OpenOrbis/PS4Toolchain)
endif()
if(NOT EXISTS "${OO_PS4_TOOLCHAIN}/lib/crt1.o")
  message(FATAL_ERROR "Set OO_PS4_TOOLCHAIN to an OpenOrbis SDK")
endif()
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-freebsd12-elf)
set(CMAKE_AR llvm-ar)
set(CMAKE_RANLIB llvm-ranlib)
set(CMAKE_SYSROOT "${OO_PS4_TOOLCHAIN}")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -D__ORBIS__ -D__PS4__ -DORBIS -nostdinc++ -D_LIBCPP_HAS_NO_LOCALE -isystem ${OO_PS4_TOOLCHAIN}/include/c++/v1 -isystem ${OO_PS4_TOOLCHAIN}/include")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld -nostdlib -Wl,-pie,--eh-frame-hdr,-z,max-page-size=0x4000 -Wl,--script=${OO_PS4_TOOLCHAIN}/link.x -L${OO_PS4_TOOLCHAIN}/lib ${OO_PS4_TOOLCHAIN}/lib/crt1.o")
set(CMAKE_CXX_STANDARD_LIBRARIES "-lc++ -lc++abi -lunwind -lc -lkernel")
set(MDC_PS4 ON CACHE BOOL "Build the PS4 bring-up application")
